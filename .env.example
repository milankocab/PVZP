# Volitelné. Bez klíče se PostHog nenačte. Měří všechny kliky a eventy funnelu, bez cookies.
VITE_POSTHOG_KEY=
# EU cloud. Pro US účet https://us.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Volitelné. Bez ID se Google Analytics 4 nenačte a eventy se ukládají jen lokálně.
VITE_GA4_ID=
